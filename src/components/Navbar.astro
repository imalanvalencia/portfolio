---
import Logo from "../assets/logo.svg";
import { Icon } from "astro-icon/components";
import { contactLinks } from "../data/contact";

const navigationLinks = [
  { name: "Inicio", href: "/" },
  { name: "Proyectos", href: "/#projects" },
  { name: "Sobre mí", href: "/#about" },
  { name: "Contacto", href: "/#contact" },
];
---

<!-- ═══════════════════════════════════════════════════════
     DESKTOP HEADER (≥1024px)
     ═══════════════════════════════════════════════════════ -->
<header
  class="hidden lg:flex justify-between items-center p-6 fixed top-0 left-0 right-0 z-50"
>
  <a
    href="/"
    class="w-37.5 text-white/90 hover:text-green-400 transition-colors"
  >
    <Logo />
  </a>

  <nav>
    <ul class="flex gap-4">
      {
        navigationLinks.map((link) => (
          <a
            href={link.href}
            class="font-crimson-pro font-extrabold text-xl text-white/90 hover:text-green-400 transition-colors duration-300"
          >
            <li>{link.name}</li>
          </a>
        ))
      }
    </ul>
  </nav>

  <div>
    <span class="block w-8 h-8 rounded-full bg-red-500"></span>
  </div>
</header>

<!-- ═══════════════════════════════════════════════════════
     MOBILE/TABLET HEADER (<1024px)
     ═══════════════════════════════════════════════════════ -->
<header
  class="flex lg:hidden justify-between items-center p-6 fixed top-0 left-0 right-0 z-50"
>
  <a
    href="/"
    class="w-24 text-white/90 hover:text-green-400 transition-colors"
  >
    <Logo />
  </a>

  <button
    id="menu-toggle"
    class="text-white/90 hover:text-green-400 transition-colors"
    aria-label="Abrir menú"
  >
    <Icon name="lucide:menu" size={28} />
  </button>
</header>

<!-- ═══════════════════════════════════════════════════════
     FULL-SCREEN OVERLAY
     ═══════════════════════════════════════════════════════ -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-100 bg-[#34d399] flex flex-col opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
>
  <!-- Overlay header -->
  <div class="flex justify-between items-center p-6">
    <a href="/" class="w-24 text-white/90">
      <Logo />
    </a>
    <button
      id="menu-close"
      class="text-white/90 hover:text-white transition-colors"
      aria-label="Cerrar menú"
    >
      <Icon name="lucide:x" size={28} />
    </button>
  </div>

  <!-- Centered nav links -->
  <nav class="flex-1 flex flex-col items-center justify-center gap-8">
    {
      navigationLinks.map((link) => (
        <a
          href={link.href}
          class="font-crimson-pro font-extrabold text-4xl md:text-5xl text-white/90 hover:text-white transition-colors duration-300"
        >
          {link.name}
        </a>
      ))
    }
  </nav>

  <!-- Bottom section -->
  <div class="flex flex-col items-center gap-4 pb-8">
    <!-- Dark mode toggle + Language selector -->
    <div class="flex items-center gap-4">
      <button
        class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white hover:bg-blue-700 transition-colors"
        aria-label="Cambiar tema"
      >
        <Icon name="lucide:moon" size={20} />
      </button>
      <button
        class="flex items-center gap-1 text-white/90 hover:text-white font-crimson-pro font-bold text-lg"
        aria-label="Cambiar idioma"
      >
        <Icon name="lucide:globe" size={20} />
        <span>ES</span>
      </button>
    </div>

    <!-- Social icons -->
    <div class="flex items-center gap-4">
      {
        contactLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
            class="text-white/90 hover:text-white transition-colors"
          >
            <Icon name={link.icon} size={24} />
          </a>
        ))
      }
    </div>

    <!-- Copyright -->
    <p class="text-white/60 text-sm font-crimson-pro">
      &copy; 2023 by Alan Valencia. ALL RIGHTS RESERVED.
    </p>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     SCRIPT — Toggle, ESC, scroll lock
     ═══════════════════════════════════════════════════════ -->
<script>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const overlay = document.getElementById("menu-overlay");
  const body = document.body;

  function openMenu() {
    overlay?.classList.remove("opacity-0", "pointer-events-none");
    overlay?.classList.add("opacity-100", "pointer-events-auto");
    body.style.overflow = "hidden";
  }

  function closeMenu() {
    overlay?.classList.remove("opacity-100", "pointer-events-auto");
    overlay?.classList.add("opacity-0", "pointer-events-none");
    body.style.overflow = "";
  }

  toggle?.addEventListener("click", openMenu);
  close?.addEventListener("click", closeMenu);

  // Close on nav link click
  overlay?.querySelectorAll("nav a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });
</script>
