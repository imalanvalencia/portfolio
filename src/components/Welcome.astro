---
import background from "../assets/background.svg";
import { contactLinks } from "../data/contact";
import { mostUsedTech } from "../data/tech";
import Carrousel from "./Carrousel.astro";
import { Icon } from "astro-icon/components";
import RecentProjectCards from "./RecentProjectCards.astro";
import Section from "./Section.astro";
---

<div id="container">
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <main>
    <Section id="hero">
      <!-- Background name text -->
      <h1 class="hero-name">
        <span>SOY ALAN</span>
        <span>VALENCIA</span>
      </h1>

      <!-- Social card - top left -->
      <article class="card card-social">
        <h2>LET'S CONNECT</h2>
        <div class="card-icons">
          {
            contactLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                aria-label={link.label}
              >
                <Icon name={link.icon} size={24} />
              </a>
            ))
          }
        </div>
      </article>

      <!-- Tech card - right side -->
      <article class="card card-tech">
        <h2>More Used Tech</h2>
        <div class="card-icons">
          {
            mostUsedTech.map((item) => (
              <span class="tech-badge">
                <Icon name={item.icon} size={24} />
              </span>
            ))
          }
        </div>
      </article>

      <!-- Role badge -->
      <article class="role-badge">
        <span>DESARROLLADOR<br />DE SOFTWARE</span>
      </article>
    </Section>
  </main>

  <!-- Actions row -->
  <article class="hero-actions">
    <a href="" class="btn btn-outline">Download CV</a>
    <a href="#contacto" class="btn btn-outline">Hire me</a>
  </article>

  <!-- Recent projects -->
  <article class="hero-projects">
    <Carrousel title="Recent Projects">
      <RecentProjectCards />
    </Carrousel>
  </article>
</div>

<style>
  /* ── Background ── */
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }

  #container {
    height: 100%;
  }

  main {
    height: 100%;
    display: flex;
    justify-content: center;
  }

  #hero {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    --hero-fs: clamp(4rem, 14vw, 12rem);
  }

  /* ── Giant background name ── */
  .hero-name {
    font-size: var(--hero-fs);
    font-weight: 900;
    line-height: 0.9;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.08);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    margin: 0;
    padding: 0;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: max-content;
  }

  .hero-name span {
    display: block;
  }

  /* ── Floating cards (shared) ── */
  .card {
    position: absolute;
    border-radius: 16px;
    padding: 16px 20px;
    z-index: 10;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .card h2 {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 10px;
    color: #111;
  }

  .card-icons {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .card-icons a {
    color: #111;
    display: flex;
    align-items: center;
    transition: opacity 0.2s;
  }

  .card-icons a:hover {
    opacity: 0.7;
  }

  /* Social card — top left, anclada arriba de la "S" del nombre gigante.
     El nombre está centrado (top 50%) con 2 líneas de line-height 0.9,
     así que su borde superior vive en calc(50% + 0.9 * font-size) desde
     abajo. La tarjeta se posiciona con ese mismo cálculo. */
  .card-social {
    background: #34d399;
    top: auto;
    bottom: calc(50% + 0.9 * var(--hero-fs) + 16px);
    left: 5%;
    transform: rotate(-8deg);
  }

  /* Tech card — right */
  .card-tech {
    background: #a78bfa;
    top: 38%;
    right: 5%;
    transform: rotate(4deg);
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: #111;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  /* ── Role badge (blob) ── */
  .role-badge {
    position: absolute;
    bottom: 22%;
    left: 50%;
    transform: translateX(-50%) rotate(-6deg);
    background: #4a3728;
    color: #fff;
    padding: 20px 40px;
    border-radius: 40% 60% 55% 45% / 55% 40% 60% 45%;
    z-index: 10;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .role-badge span {
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1.1;
    letter-spacing: 1px;
    white-space: nowrap;
  }

  /* ── Action buttons ── */
  .hero-actions {
    position: absolute;
    bottom: 12%;
    right: 5%;
    display: flex;
    gap: 12px;
    z-index: 10;
  }

  .btn {
    padding: 10px 24px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-outline {
    border: 2px solid #111;
    color: #111;
    background: transparent;
  }

  .btn-outline:hover {
    background: #111;
    color: #fff;
  }

  /* ── Recent projects ── */
  .hero-projects {
    position: absolute;
    bottom: 2%;
    left: 5%;
    z-index: 10;
    max-width: 320px;
  }

  /* ────────────────────────────────────────────
     RESPONSIVE — Tablet & Desktop
     ──────────────────────────────────────────── */
  @media screen and (min-width: 769px) {
    #hero {
      width: 100%;
      min-height: 100dvh;
    }
  }

  /* ────────────────────────────────────────────
     RESPONSIVE — Mobile
     ──────────────────────────────────────────── */
  @media screen and (max-width: 768px) {
    #hero {
      min-height: 100dvh;
      padding: 16px;
      justify-content: flex-start;
      padding-top: 10%;
    }

    .hero-name {
      font-size: clamp(3rem, 16vw, 6rem);
      top: 20%;
      left: 50%;
    }

    /* Stack cards vertically */
    .card-social {
      top: 2%;
      bottom: auto;
      left: 0;
      transform: rotate(-6deg);
    }

    .card-tech {
      position: relative;
      top: auto;
      right: auto;
      transform: rotate(3deg);
      margin-top: 100px;
      align-self: flex-end;
      margin-right: 0;
    }

    /* Role badge */
    .role-badge {
      position: relative;
      bottom: auto;
      left: auto;
      transform: rotate(-4deg);
      margin-top: 24px;
      align-self: center;
    }

    /* Actions */
    .hero-actions {
      position: relative;
      bottom: auto;
      right: auto;
      margin-top: 24px;
      justify-content: center;
      width: 100%;
    }

    /* Projects */
    .hero-projects {
      position: relative;
      bottom: auto;
      left: auto;
      margin-top: 24px;
      max-width: 100%;
      width: 100%;
    }
  }

  /* ── Small phones ── */
  @media screen and (max-width: 400px) {
    .hero-name {
      font-size: clamp(2.5rem, 18vw, 4rem);
    }

    .role-badge {
      padding: 14px 24px;
    }

    .role-badge span {
      font-size: 1rem;
    }

    .card {
      padding: 12px 14px;
    }

    .card h2 {
      font-size: 12px;
    }

    .tech-badge {
      width: 26px;
      height: 26px;
      font-size: 9px;
    }
  }
</style>
